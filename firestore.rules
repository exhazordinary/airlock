rules_version = '2';

// AIRLOCK data model. Receipts and quota are written only by the backend via the
// Admin SDK, which bypasses these rules. A user can read their own audit trail;
// nobody can forge one from the client.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/documents/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/receipts/{receiptId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/quota/{quotaId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
